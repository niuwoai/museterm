+fn task(
+    session: Uuid,
+    agent: Uuid,
+    created_at: u64,
+    status: willdeep_runtime_protocol::TaskStatus,
+) -> crate::daemon::tui_bridge::RemoteTask {
+    crate::daemon::tui_bridge::RemoteTask {
+        id: Uuid::new_v4(),
+        session_id: Some(session),
+        turn_id: None,
+        agent_id: Some(agent),
+        status,
+        profile: None,
+        created_at,
+        started_at: Some(created_at),
+        completed_at: None,
+        exit_code: None,
+        failure_domain: None,
+    }
+}
+
+#[test]
+fn background_or_other_session_completion_never_finishes_root() {
+    use willdeep_runtime_protocol::TaskStatus;
+    let session = Uuid::new_v4();
+    let root = Uuid::new_v4();
+    let child = Uuid::new_v4();
+    let tasks = vec![
+        task(session, root, 1, TaskStatus::Running),
+        task(session, child, 3, TaskStatus::Completed),
+        task(Uuid::new_v4(), root, 4, TaskStatus::Completed),
+    ];
+    assert_eq!(main_task(&tasks, session, &[root]).unwrap().id, tasks[0].id);
+    assert!(main_task(&tasks, Uuid::new_v4(), &[root]).is_none());
+}
+
+#[test]
+fn active_root_has_priority_over_finished_history() {
+    use willdeep_runtime_protocol::TaskStatus;
+    let session = Uuid::new_v4();
+    let root = Uuid::new_v4();
+    let tasks = vec![
+        task(session, root, 2, TaskStatus::WaitingApproval),
+        task(session, root, 3, TaskStatus::Completed),
+    ];
+    assert_eq!(
+        main_task(&tasks, session, &[root]).unwrap().status,
+        TaskStatus::WaitingApproval
+    );
+}
+
+#[test]
+fn final_result_is_not_lost_when_a_local_gate_closes_at_completion() {
+    let mut view = ViewState::new(memory_reporter());
+    let session = Uuid::new_v4();
+    view.observe(session, true, false, true, false, 1);
+    view.finished(session, RuntimeStatus::Done);
+    view.observe(session, false, false, false, false, 2);
+    assert_eq!(state(&view.reporter).result, Some("completed"));
+}
+
+#[test]
+fn missing_endpoint_keeps_cli_behavior_optional() {
+    assert!(
+        transport::Endpoint::open(std::path::Path::new("/nonexistent/qterm-context.json")).is_err()
+    );
+    let reporter = Reporter::default();
+    reporter.update(Uuid::new_v4(), None, None, RuntimeStatus::Working);
+    assert!(!reporter.take_error());
+}
+
+#[test]
+fn old_completed_snapshot_cannot_finish_a_new_queued_turn() {
+    use willdeep_runtime_protocol::TaskStatus;
+    let session = Uuid::new_v4();
+    let reporter = memory_reporter();
+    reporter.update(
+        session,
+        Some("new-turn".into()),
+        None,
+        RuntimeStatus::Working,
+    );
+    let mut old = task(session, Uuid::new_v4(), 1, TaskStatus::Completed);
+    old.agent_id = None;
+    let snapshot = crate::daemon::RuntimeSnapshot {
+        attention: vec![],
+        gates: vec![],
+        agents: vec![],
+        tasks: vec![old],
+        tools: vec![],
+        artifacts: vec![],
+        runtime_version: None,
+        event_sequence: Some(5),
+        mobile: None,
+    };
+    reporter.runtime_snapshot(&snapshot, session, 5, true);
+    assert_eq!(state(&reporter).activity, "working");
+    assert_eq!(
+        state(&reporter).context.task_id.as_deref(),
+        Some("new-turn")
+    );
+}
+
+#[test]
+fn adopting_running_runtime_does_not_reset_a_pending_approval() {
+    let session = Uuid::new_v4();
+    let mut view = ViewState::new(memory_reporter());
+    view.observe(session, false, false, false, false, 0);
+    view.reporter.update(
+        session,
+        Some("runtime-task".into()),
+        Some("gate".into()),
+        RuntimeStatus::WaitingApproval,
+    );
+    view.observe(session, true, true, true, false, 1);
+    assert_eq!(state(&view.reporter).activity, "blocked");
+    assert_eq!(
+        state(&view.reporter).context.gate_id.as_deref(),
+        Some("gate")
+    );
+}
+
+#[test]
+fn runtime_history_does_not_overwrite_a_local_turn() {
+    use willdeep_runtime_protocol::TaskStatus;
+    let session = Uuid::new_v4();
+    let mut view = ViewState::new(memory_reporter());
+    view.observe(session, true, false, false, false, 0);
+    let mut old = task(session, Uuid::new_v4(), 1, TaskStatus::Completed);
+    old.agent_id = None;
+    let snapshot = crate::daemon::RuntimeSnapshot {
+        attention: vec![],
+        gates: vec![],
+        agents: vec![],
+        tasks: vec![old],
+        tools: vec![],
+        artifacts: vec![],
+        runtime_version: None,
+        event_sequence: Some(5),
+        mobile: None,
+    };
+    view.finished(session, RuntimeStatus::Failed);
+    view.observe(session, false, false, false, false, 0);
+    view.runtime_snapshot(&snapshot, session, 5, false);
+    assert_eq!(state(&view.reporter).result, Some("failed"));
+}
diff --git a/crates/willdeep-cli/src/qterm/transport.rs b/crates/willdeep-cli/src/qterm/transport.rs
new file mode 100644
index 0000000..cb88915
--- /dev/null
+++ b/crates/willdeep-cli/src/qterm/transport.rs
@@ -0,0 +1,165 @@
+use super::State;
+use serde::Deserialize;
+use serde_json::{Value, json};
+use std::fs::{self, File, OpenOptions};
+use std::io::{self, Read, Write};
+use std::path::{Path, PathBuf};
+use std::time::{Duration, Instant};
+use uuid::Uuid;
+
+const REQUEST_TIMEOUT: Duration = Duration::from_secs(2);
+const MAX_FILE_SIZE: u64 = 65_536;
+
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase")]
+struct Descriptor {
+    protocol_version: u32,
+    #[serde(rename = "tabID")]
+    tab_id: Uuid,
+    root: PathBuf,
+    token: String,
+}
+
+pub(super) struct Endpoint {
+    descriptor: Descriptor,
+    grant: Option<Value>,
+    sequence: u64,
+    session: Option<Uuid>,
+}
+
+impl Endpoint {
+    pub(super) fn open(path: &Path) -> io::Result<Self> {
+        let descriptor: Descriptor = serde_json::from_slice(&read_private(path)?)?;
+        if descriptor.protocol_version != 1
+            || descriptor.token.len() != 72
+            || !descriptor.root.is_absolute()
+        {
+            return Err(io::Error::other("unsupported QTerm status context"));
+        }
+        Ok(Self {
+            descriptor,
+            grant: None,
+            sequence: 0,
+            session: None,
+        })
+    }
+
+    pub(super) fn report(&mut self, state: &State) -> io::Result<()> {
+        if self.session != Some(state.context.session_id) {
+            self.grant = None;
+        }
+        if self.grant.is_none() {
+            let response = self
+                .request(json!({"action":"bind_native_agent", "agentKind":"willdeep",
+                "nativeAgentToken": self.descriptor.token}))?;
+            let grant = response
+                .get("agentGrant")
+                .filter(|grant| {
+                    grant.get("token").and_then(Value::as_str).is_some()
+                        && grant.get("runID").and_then(Value::as_str).is_some()
+                        && grant.get("instanceID").and_then(Value::as_str).is_some()
+                })
+                .ok_or_else(|| io::Error::other("invalid QTerm status grant"))?;
+            self.grant = Some(grant.clone());
+            self.session = Some(state.context.session_id);
+            self.sequence = 0;
+        }
+        self.sequence = self
+            .sequence
+            .checked_add(1)
+            .ok_or_else(|| io::Error::other("status sequence exhausted"))?;
+        let mut report = serde_json::to_value(state)?;
+        for field in ["token", "runID", "instanceID"] {
+            report[field] = self.grant.as_ref().unwrap()[field].clone();
+        }
+        report["sequence"] = self.sequence.into();
+        // A retired grant is never rebound automatically: a newer WillDeep owns this terminal now.
+        self.request(json!({"action":"report_agent_state", "agentReport": report}))
+            .map(|_| ())
+    }
+
+    fn request(&self, mut request: Value) -> io::Result<Value> {
+        let id = Uuid::new_v4().to_string();
+        request["id"] = id.clone().into();
+        request["tab"] = self.descriptor.tab_id.to_string().into();
+        let pending = self
+            .descriptor
+            .root
+            .join("requests")
+            .join(format!("{id}.pending"));
+        let published = pending.with_extension("json");
+        let response = self
+            .descriptor
+            .root
+            .join("responses")
+            .join(format!("{id}.json"));
+        let result = (|| {
+            let mut options = OpenOptions::new();
+            options.write(true).create_new(true);
+            #[cfg(unix)]
+            {
+                use std::os::unix::fs::OpenOptionsExt;
+                options.mode(0o600).custom_flags(libc::O_NOFOLLOW);
+            }
+            let mut file = options.open(&pending)?;
+            file.write_all(&serde_json::to_vec(&request)?)?;
+            file.sync_all()?;
+            drop(file);
+            fs::rename(&pending, &published)?;
+            let deadline = Instant::now() + REQUEST_TIMEOUT;
+            loop {
+                match read_private(&response) {
+                    Ok(data) => {
+                        let response: Value = serde_json::from_slice(&data)?;
+                        if response["id"] != id || response["ok"] != true {
+                            return Err(io::Error::other("QTerm status request rejected"));
+                        }
+                        return Ok(response);
+                    }
+                    Err(error)
+                        if error.kind() == io::ErrorKind::NotFound && Instant::now() < deadline =>
+                    {
+                        std::thread::sleep(Duration::from_millis(20))
+                    }
+                    Err(error) => return Err(error),
+                }
+            }
+        })();
+        for path in [&pending, &published, &response] {
+            if let Err(error) = fs::remove_file(path)
+                && error.kind() != io::ErrorKind::NotFound
+            {
+                return Err(io::Error::other("QTerm status request cleanup failed"));
+            }
+        }
+        result
+    }
+}
+
+fn read_private(path: &Path) -> io::Result<Vec<u8>> {
+    let mut options = OpenOptions::new();
+    options.read(true);
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::OpenOptionsExt;
+        options.custom_flags(libc::O_NOFOLLOW);
+    }
+    let file: File = options.open(path)?;
+    let metadata = file.metadata()?;
+    if !metadata.is_file() || metadata.len() > MAX_FILE_SIZE {
+        return Err(io::Error::other("invalid QTerm status file"));
+    }
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::MetadataExt;
+        if metadata.uid() != unsafe { libc::getuid() } || metadata.mode() & 0o077 != 0 {
+            return Err(io::Error::other("unsafe QTerm status file permissions"));
+        }
+    }
+    let mut data = Vec::new();
+    file.take(MAX_FILE_SIZE + 1).read_to_end(&mut data)?;
+    if data.len() as u64 > MAX_FILE_SIZE {
+        return Err(io::Error::other("oversized QTerm status file"));
+    }
+    Ok(data)
+}
